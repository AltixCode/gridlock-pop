{
  "name": "cubex",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.22",
    "expo-application": "~57.0.3",
    "expo-asset": "~57.0.17",
    "expo-audio": "~57.0.5",
    "expo-build-properties": "~57.0.17",
    "expo-constants": "~57.0.18",
    "expo-haptics": "~57.0.3",
    "expo-linear-gradient": "~57.0.2",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-tracking-transparency": "~57.0.2",
    "expo-updates": "~57.0.22",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-google-mobile-ads": "^16.3.4",
    "react-native-purchases": "^10.9.1",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.10.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^26.5.1",
    "@types/react": "~19.2.2",
    "babel-preset-expo": "^57.0.11",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "jest": "^29.7.0",
    "jest-expo": "^57.0.5",
    "prettier": "^3.9.6",
    "sharp": "^0.35.4",
    "tsx": "^4.23.13",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest --watch",
    "test:ci": "jest --ci --coverage --runInBand",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "assets": "node scripts/generate-icons.mjs",
    "doctor": "npx expo-doctor",
    "prebuild": "expo prebuild --clean",
    "build:preview": "eas build --profile preview --platform all",
    "build:production": "npm run check:release && eas build --profile production --platform all",
    "submit:production": "eas submit --profile production --platform all --latest",
    "verify": "npm run lint && npm run typecheck && npm run test:ci",
    "balance": "tsx scripts/balance.ts",
    "check:release": "tsx scripts/check-release-config.ts"
  },
  "private": true
}
