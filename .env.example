# Copy to .env.local for local development. Never commit real values.
# All EXPO_PUBLIC_* values are embedded in the app bundle — only put client-side
# identifiers here. Secret keys (RevenueCat v2 API key, Play service account,
# App Store Connect API key) belong in EAS secrets / GitHub Actions secrets only.

# --- AdMob (console.admob.google.com) ---
EXPO_PUBLIC_ADMOB_IOS_APP_ID=ca-app-pub-XXXXXXXXXXXXXXXX~XXXXXXXXXX
EXPO_PUBLIC_ADMOB_ANDROID_APP_ID=ca-app-pub-XXXXXXXXXXXXXXXX~XXXXXXXXXX
EXPO_PUBLIC_ADMOB_IOS_INTERSTITIAL=ca-app-pub-XXXXXXXXXXXXXXXX/XXXXXXXXXX
EXPO_PUBLIC_ADMOB_ANDROID_INTERSTITIAL=ca-app-pub-XXXXXXXXXXXXXXXX/XXXXXXXXXX
EXPO_PUBLIC_ADMOB_IOS_REWARDED=ca-app-pub-XXXXXXXXXXXXXXXX/XXXXXXXXXX
EXPO_PUBLIC_ADMOB_ANDROID_REWARDED=ca-app-pub-XXXXXXXXXXXXXXXX/XXXXXXXXXX
EXPO_PUBLIC_ADMOB_IOS_BANNER=ca-app-pub-XXXXXXXXXXXXXXXX/XXXXXXXXXX
EXPO_PUBLIC_ADMOB_ANDROID_BANNER=ca-app-pub-XXXXXXXXXXXXXXXX/XXXXXXXXXX

# --- RevenueCat (app.revenuecat.com) — public SDK keys, safe to ship ---
EXPO_PUBLIC_REVENUECAT_IOS_KEY=appl_XXXXXXXXXXXXXXXXXXXXXXXXXXXX
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=goog_XXXXXXXXXXXXXXXXXXXXXXXXXXXX

# --- Store listing links ---
EXPO_PUBLIC_PRIVACY_POLICY_URL=https://atasmohammadi.github.io/blockjam/legal/privacy.html
EXPO_PUBLIC_TERMS_URL=https://atasmohammadi.github.io/blockjam/legal/terms.html
EXPO_PUBLIC_SUPPORT_EMAIL=support@altixcode.com
